    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({ once: false, offset: 50, duration: 1000 });

        // Animasi Ledakan Bintang
        function createExplosion() {
            const container = document.getElementById('particle-container');
            const colors = ['#D4AF37', '#FFF8E7', '#C5A059'];
            for(let i=0; i<100; i++) {
                let p = document.createElement('div');
                p.className = 'particle';
                p.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
                p.style.width = (Math.random() * 5 + 2) + 'px';
                p.style.height = p.style.width;
                p.style.top = '50%'; p.style.left = '50%';
                
                let angle = Math.random() * Math.PI * 2;
                let velocity = 80 + Math.random() * 250; 
                let tx = Math.cos(angle) * velocity;
                let ty = Math.sin(angle) * velocity;
                
                p.animate([
                    { transform: 'translate(-50%, -50%) scale(1)', opacity: 1 },
                    { transform: `translate(calc(-50% + ${tx}px), calc(-50% + ${ty}px)) scale(0)`, opacity: 0 }
                ], { duration: 1000 + Math.random() * 1500, easing: 'cubic-bezier(0, .9, .57, 1)' });
                container.appendChild(p);
                setTimeout(() => p.remove(), 2500);
            }
        }

        // Hujan Emas Aesthetic
        function startMagicRain() {
            const container = document.getElementById('rain-container');
            setInterval(() => {
                let rain = document.createElement('div');
                rain.className = 'magic-rain';
                rain.style.left = Math.random() * 100 + 'vw';
                rain.style.animationDuration = (Math.random() * 4 + 4) + 's'; 
                container.appendChild(rain);
                setTimeout(() => rain.remove(), 8000); 
            }, 400); 
        }

        // Setup Player YouTube Musik (tf1eWhA3MMw)
        var player;
        function onYouTubeIframeAPIReady() {
            player = new YT.Player('youtube-player', {
                height: '0', width: '0', videoId: 'tf1eWhA3MMw',
                playerVars: { 'autoplay': 0, 'controls': 0, 'showinfo': 0, 'rel': 0, 'loop': 1, 'playlist': 'tf1eWhA3MMw' }
            });
        }

        // Fungsi Tombol Buka Undangan
        function openGate() {
            const gateContent = document.getElementById('gateContent');
            const gateLeft = document.getElementById('gateLeft');
            const gateRight = document.getElementById('gateRight');
            const musicBtn = document.getElementById('music-btn');
            
            // 1. Mainkan Ledakan Partikel
            createExplosion();
            
            // 2. Transisi Hilang Archway & Pintu Terbuka
            gateContent.classList.add('hide');
            gateLeft.classList.add('open');
            gateRight.classList.add('open');
            
            // 3. Unlock Scroll & Munculkan Tombol Musik
            document.body.classList.remove('lock-scroll');
            musicBtn.classList.add('show');
            startMagicRain();

            // 4. Bersihkan DOM yang tidak terlihat
            setTimeout(() => {
                document.querySelector('.gate-container').style.display = 'none';
                AOS.refresh(); 
            }, 1500);

            // 5. Putar Lagu
            try {
                if (player && typeof player.playVideo === 'function') {
                    player.playVideo();
                    musicBtn.classList.add('playing');
                }
            } catch (e) { console.log(e); }
        }

        function toggleMusic() {
            var btn = document.getElementById("music-btn");
            if (player && typeof player.getPlayerState === 'function') {
                if (player.getPlayerState() === 1) { 
                    player.pauseVideo(); btn.classList.remove("playing");
                } else { 
                    player.playVideo(); btn.classList.add("playing");
                }
            }
        }

        // Countdown Acara
        const targetDate = new Date("Jun 29, 2026 10:00:00").getTime();
        setInterval(function() {
            const now = new Date().getTime();
            const distance = targetDate - now;
            if (distance > 0) {
                document.getElementById("hari").innerText = Math.floor(distance / (1000 * 60 * 60 * 24)).toString().padStart(2, '0');
                document.getElementById("jam").innerText = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)).toString().padStart(2, '0');
                document.getElementById("menit").innerText = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60)).toString().padStart(2, '0');
                document.getElementById("detik").innerText = Math.floor((distance % (1000 * 60)) / 1000).toString().padStart(2, '0');
            }
        }, 1000);

        function copyRek() {
            var rekText = document.getElementById("rek-bca").innerText;
            navigator.clipboard.writeText(rekText).then(() => { alert("Nomor Rekening disalin! 💳"); });
        }

        // Fitur Kirim RSVP ke WA
        function kirimPesan() {
            var nama = document.getElementById("namaTamu").value;
            var pesan = document.getElementById("pesanTamu").value;
            var hadir = document.getElementById("hadirTamu").value;
            
            if(nama === "" || pesan === "") { alert("Mohon lengkapi Nama dan Pesan ✨"); return; }

            var areaKomentar = document.getElementById("daftarKomentar");
            var elemenBaru = document.createElement("div");
            elemenBaru.className = "comment-item";
            elemenBaru.innerHTML = `<div class="comment-name">${nama} <span style="font-weight:normal; color:#888; font-size:11px;">(${hadir})</span></div><div class="comment-text">"${pesan}"</div>`;

            areaKomentar.prepend(elemenBaru);
            document.getElementById("namaTamu").value = ""; document.getElementById("pesanTamu").value = "";

            setTimeout(function() {
                var noWA = "6281234567890"; 
                var teksWA = "Halo Amar & Aulia!%0A%0A*Nama:* " + nama + "%0A*Kehadiran:* " + hadir + "%0A*Pesan:* " + pesan;
                window.open("https://wa.me/" + noWA + "?text=" + teksWA, '_blank');
            }, 600); 
        }
    </script>
</body>
</html>
