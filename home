<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Wedding of Amar & Aulia</title>
    
    <!-- Premium Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Outfit:wght@300;400;500;600&family=Great+Vibes&family=Amiri:ital,wght@0,400;0,700&display=swap" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <style>
        :root {
            --primary: #4a0e17; /* Lebih gelap, lebih elegan (Burgundy) */
            --primary-light: #7a1b29; 
            --gold: #D4AF37; 
            --gold-light: #F3E5AB;
            --bg-dark: #0a0505;
            --text-light: #fdfbf7;
            --glass-bg: rgba(20, 10, 10, 0.4);
            --glass-border: rgba(212, 175, 55, 0.25);
            --font-display: 'Cinzel', serif;
            --font-serif: 'Playfair Display', serif;
            --font-sans: 'Outfit', sans-serif;
            --font-hand: 'Great Vibes', cursive;
            --font-arabic: 'Amiri', serif;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; scroll-behavior: smooth; }

        body.lock-scroll { overflow: hidden !important; height: 100vh; }

        body {
            font-family: var(--font-sans);
            background-color: var(--bg-dark); color: var(--text-light);
            display: flex; justify-content: center; overflow-x: hidden;
            background-image: radial-gradient(circle at center, #1f0509 0%, #050202 100%);
        }

        /* =========================================
           1. OPENING SCREEN: ARCHWAY GEN Z AESTHETIC
           ========================================= */
        .gate-container { position: fixed; top: 0; left: 0; width: 100%; height: 100vh; z-index: 9999; display: flex; pointer-events: none; }
        
        /* Background pintu dibikin lebih bertekstur dan cinematic */
        .gate { width: 50%; height: 100%; background: linear-gradient(180deg, var(--primary) 0%, #000000 100%); position: relative; transition: 1.5s cubic-bezier(0.77, 0, 0.175, 1); pointer-events: auto; }
        .gate::after { content: ''; position: absolute; top:0; left:0; width:100%; height:100%; background-image: url('https://www.transparenttextures.com/patterns/stardust.png'); opacity: 0.3; }
        
        .gate-left { border-right: 1px solid rgba(212, 175, 55, 0.4); }
        .gate-right { border-left: 1px solid rgba(212, 175, 55, 0.4); }
        
        .gate-left.open { transform: translateX(-100%); }
        .gate-right.open { transform: translateX(100%); }
        
        /* Konten Opening Tengah */
        .gate-content {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
            z-index: 10000; text-align: center; color: white; display: flex; flex-direction: column; align-items: center;
            transition: 0.8s ease-in-out; pointer-events: auto; width: 100%;
        }
        .gate-content.hide { opacity: 0; transform: translate(-50%, -55%) scale(0.95); pointer-events: none; }

        /* Desain Bingkai Melengkung (Archway) yang sedang Trend */
        .arch-cover {
            width: 85%; max-width: 340px;
            background: rgba(20, 5, 10, 0.5);
            backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px);
            border: 1px solid rgba(212, 175, 55, 0.3);
            border-top-left-radius: 160px; border-top-right-radius: 160px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;
            padding: 60px 20px 40px;
            box-shadow: 0 30px 60px rgba(0,0,0,0.8), inset 0 0 20px rgba(212, 175, 55, 0.1);
            animation: breathe 4s infinite ease-in-out;
            position: relative; overflow: hidden;
        }
        @keyframes breathe { 0%, 100% { transform: translateY(0); box-shadow: 0 30px 60px rgba(0,0,0,0.8), inset 0 0 20px rgba(212, 175, 55, 0.1); } 50% { transform: translateY(-10px); box-shadow: 0 40px 70px rgba(0,0,0,0.9), inset 0 0 30px rgba(212, 175, 55, 0.2); } }

        /* Hiasan abstrak minimalis di atas arch */
        .arch-ornament { font-size: 24px; color: var(--gold); margin-bottom: 20px; animation: spinSlow 10s linear infinite; }
        @keyframes spinSlow { 100% { transform: rotate(360deg); } }

        .arch-subtitle { font-family: var(--font-sans); font-size: 10px; letter-spacing: 4px; color: var(--gold); text-transform: uppercase; margin-bottom: 15px; }
        .arch-title { font-family: var(--font-display); font-size: 40px; line-height: 1.2; color: #fff; margin-bottom: 5px; text-shadow: 0 5px 15px rgba(0,0,0,0.5); }
        .arch-date { font-family: var(--font-serif); font-size: 14px; letter-spacing: 3px; color: #ccc; margin-top: 15px; font-style: italic; }

        /* Tombol Modern Opening */
        .btn-open-cool {
            background: transparent; color: var(--gold-light);
            border: 1px solid var(--gold); padding: 14px 35px; border-radius: 40px;
            text-transform: uppercase; letter-spacing: 2px; font-size: 11px;
            margin-top: 35px; position: relative; overflow: hidden;
            transition: all 0.4s; font-family: var(--font-sans); cursor: pointer;
            box-shadow: 0 0 15px rgba(212,175,55,0.2);
        }
        .btn-open-cool::before {
            content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(212,175,55,0.4), transparent);
            transition: all 0.5s;
        }
        .btn-open-cool:hover::before { left: 100%; }
        .btn-open-cool:hover { background: var(--gold); color: var(--bg-dark); box-shadow: 0 0 25px rgba(212,175,55,0.6); transform: scale(1.05); font-weight: 600; }

        /* =========================================
           2. WADAH UTAMA KONTEN UNDANGAN
           ========================================= */
        .mobile-container { width: 100%; max-width: 450px; min-height: 100vh; position: relative; z-index: 10; overflow: hidden; padding-bottom: 50px; }
        section { padding: 60px 20px; position: relative; text-align: center; }

        .glass-card {
            background: var(--glass-bg); backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px);
            border: 1px solid var(--glass-border); border-radius: 20px;
            padding: 35px 25px; margin-bottom: 25px; box-shadow: 0 15px 35px rgba(0,0,0,0.5);
            position: relative; overflow: hidden;
        }

        /* TYPOGRAPHY ISI UNDANGAN */
        .subtitle { font-family: var(--font-sans); font-size: 11px; letter-spacing: 4px; color: var(--gold); text-transform: uppercase; margin-bottom: 15px; font-weight: 600; }
        h1 { font-family: var(--font-display); font-size: 42px; line-height: 1.1; color: var(--gold-light); font-weight: 500; text-shadow: 0 5px 15px rgba(0,0,0,0.5); }
        .ampersand { font-family: var(--font-hand); font-size: 50px; color: var(--primary-light); margin: -5px 0; text-shadow: 0 0 20px rgba(255,255,255,0.2); }
        h2 { font-family: var(--font-display); font-size: 28px; margin-bottom: 20px; color: var(--gold); border-bottom: 1px solid rgba(212, 175, 55, 0.3); padding-bottom: 10px; display: inline-block; }

        /* FRAME FOTO AESTHETIC DALAM ISI */
        .aesthetic-frame {
            position: relative; width: 80%; margin: 25px auto;
            background: #fff; padding: 10px 10px 40px 10px;
            border-radius: 4px; box-shadow: 0 20px 50px rgba(0,0,0,0.5);
            transform: rotate(2deg); transition: 0.5s;
        }
        .aesthetic-frame:hover { transform: rotate(0deg) scale(1.03); }
        .aesthetic-frame img { width: 100%; height: 350px; object-fit: cover; filter: sepia(20%) contrast(1.1); border-radius: 2px; }
        .frame-caption { position: absolute; bottom: 10px; left: 0; width: 100%; font-family: var(--font-hand); font-size: 22px; color: #111; }

        /* BUTTONS UMUM */
        .btn-gold {
            display: inline-block; background: linear-gradient(135deg, var(--gold), #9c7b16); color: var(--bg-dark);
            padding: 14px 30px; border-radius: 30px; font-weight: 600; text-decoration: none; font-family: var(--font-sans);
            letter-spacing: 1px; width: 100%; border: none; cursor: pointer; transition: 0.3s; font-size: 13px; text-transform: uppercase;
        }
        .btn-gold:hover { transform: translateY(-3px); box-shadow: 0 15px 25px rgba(212, 175, 55, 0.5); background: #fff; color: var(--primary); }

        /* COUNTDOWN */
        .cd-wrapper { display: flex; justify-content: space-between; gap: 8px; margin-top: 25px; }
        .cd-item { background: rgba(0,0,0,0.6); border: 1px solid var(--glass-border); border-radius: 12px; padding: 15px 5px; flex: 1; backdrop-filter: blur(5px); }
        .cd-num { font-family: var(--font-display); font-size: 24px; color: var(--gold-light); font-weight: bold; }
        .cd-label { font-size: 9px; color: #aaa; text-transform: uppercase; letter-spacing: 1px; margin-top: 5px; }

        /* RSVP UI */
        .input-form { width: 100%; padding: 15px; border: 1px solid var(--glass-border); border-radius: 10px; margin-bottom: 15px; font-family: var(--font-sans); font-size: 14px; background: rgba(0,0,0,0.3); color: #fff; }
        .input-form:focus { outline: none; border-color: var(--gold); background: rgba(0,0,0,0.6); }
        .guestbook-area { margin-top: 30px; text-align: left; max-height: 250px; overflow-y: auto; padding-right: 5px; }
        .comment-item { border-left: 2px solid var(--gold); padding: 15px; margin-bottom: 15px; background: rgba(255,255,255,0.03); border-radius: 0 10px 10px 0; }
        .comment-name { font-weight: 600; color: var(--gold-light); font-size: 14px; }
        .comment-text { font-family: var(--font-serif); font-size: 14px; color: #ccc; font-style: italic; margin-top: 5px; line-height: 1.5; }

        /* 3. VINYL MUSIC PLAYER */
        .vinyl-btn {
            position: fixed; bottom: 25px; right: 25px; z-index: 100;
            width: 55px; height: 55px; background: #111; border-radius: 50%;
            border: 2px solid var(--gold); display: flex; justify-content: center; align-items: center;
            cursor: pointer; box-shadow: 0 5px 20px rgba(0,0,0,0.5); transition: 0.3s;
            opacity: 0; pointer-events: none; 
        }
        .vinyl-btn.show { opacity: 1; pointer-events: auto; }
        .vinyl-btn::before { content: ''; position: absolute; width: 15px; height: 15px; background: var(--primary); border-radius: 50%; z-index: 2; border: 1px solid var(--gold); }
        .vinyl-btn::after { content: ''; position: absolute; width: 100%; height: 100%; border-radius: 50%; border: 1px dashed rgba(212,175,55,0.3); }
        .vinyl-btn.playing { animation: spinVinyl 4s linear infinite; box-shadow: 0 0 20px rgba(212,175,55,0.5); }
        @keyframes spinVinyl { 100% { transform: rotate(360deg); } }

        /* MAGIC DUST & RAIN CSS */
        .particle { position: fixed; border-radius: 50%; pointer-events: none; z-index: 9999; }
        .magic-rain { 
            position: fixed; top: -10px; width: 3px; height: 3px; background: var(--gold);
            box-shadow: 0 0 10px var(--gold); border-radius: 50%; z-index: 1; pointer-events: none;
            animation: rainFall linear infinite; opacity: 0;
        }
        @keyframes rainFall { 0% { opacity: 0; transform: translateY(0) scale(0.5); } 20% { opacity: 0.6; transform: scale(1); } 80% { opacity: 0.6; } 100% { transform: translateY(100vh) scale(0.5); opacity: 0; } }
    </style>
</head>
